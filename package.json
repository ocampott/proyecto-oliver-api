{
  "name": "proyecto-oliver-api",
  "version": "1.0.0",
  "description": "Backend de Proyecto Oliver — Express + Supabase",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env.local src/index.ts",
    "build": "tsc",
    "start": "node --env-file-if-exists=.env.local dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed:demo": "node --env-file=.env.local scripts/seed-demo.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@supabase/supabase-js": "^2.112.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jose": "^6.2.10",
    "multer": "^2.0.1",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.2",
    "@types/multer": "^1.4.12",
    "@types/node": "^26.2.0",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
